# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Required only for the natural-language interface, which calls the Anthropic
# API to turn plain-English questions into Cypher. The rule engine, the CBR
# layer, the CRyPTIC validation, and the test suite all run without it.
ANTHROPIC_API_KEY=

# Memgraph speaks the Bolt protocol, so the code reaches it with the neo4j
# driver. The local container in section 1 runs without authentication, so the
# user and password stay empty and the URI stays at the default below.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=
